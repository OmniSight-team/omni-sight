POSTGRES_USER=changeme
POSTGRES_PASSWORD=changeme
POSTGRES_DB=omnisight
POSTGRES_PORT=5432

ADMIN_EMAIL=admin@omnisight.local
ADMIN_PASSWORD=changeme

JWT_SECRET_KEY=changeme-generate-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=15

MAX_FAILED_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15

FRONTEND_ORIGIN=http://localhost:3000

# How many days a recording is kept. Every new upload gets retention_until =
# upload time + this many days; the retention job (slice 16) deletes footage
# once that date has passed. Must be at least 1.
VIDEO_RETENTION_DAYS=30

# Frame extraction: one frame is kept every this many seconds of video. 1.0 is
# one frame per second, so a ten-minute recording is 600 frames plus 600
# thumbnails on disk. Lower it for very short clips, raise it to save disk.
EXTRACT_INTERVAL_S=1.0
