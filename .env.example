POSTGRES_USER=changeme
POSTGRES_PASSWORD=changeme
POSTGRES_DB=omnisight
POSTGRES_PORT=5432

ADMIN_EMAIL=admin@omnisight.local
ADMIN_PASSWORD=changeme

JWT_SECRET_KEY=changeme-generate-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=15

MAX_FAILED_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15

FRONTEND_ORIGIN=http://localhost:3000

# How many days a recording is kept. Every new upload gets retention_until =
# upload time + this many days; the retention job (slice 16) deletes footage
# once that date has passed. Must be at least 1.
VIDEO_RETENTION_DAYS=30

# Frame extraction (OMNI-303 rework): every frame is decoded and gated, no
# sampling step. HEARTBEAT_INTERVAL_S is reserved for OMNI-305's heartbeat —
# admitting a frame on a fixed schedule regardless of the gate's verdict — and
# is not read anywhere yet.
HEARTBEAT_INTERVAL_S=1.0

# Algorithm 1, the motion gate (OMNI-304, Phase A §3.5.1 / Appendix B.1). A
# frame is compared against the buffered frame nearest MOTION_STRIDE_S (Δ)
# seconds earlier — a duration, not a frame count, so CCD's 10 fps clips and
# VIRAT's 30 fps clips behave the same way in time. The difference image is
# split into a MOTION_GRID_SIZE x MOTION_GRID_SIZE grid; a cell counts as
# "changed" when its mean pixel difference (0-255) exceeds
# MOTION_CELL_THRESHOLD. A frame is admitted once at least
# MOTION_MIN_ACTIVE_CELLS cells changed, and then carries a causal clip window
# of [t-2Δ, t]. MOTION_BLUR_KERNEL must stay odd.
MOTION_GRID_SIZE=8
MOTION_CELL_THRESHOLD=25.0
MOTION_MIN_ACTIVE_CELLS=3
MOTION_STRIDE_S=0.5
MOTION_BLUR_KERNEL=21

# RabbitMQ (OMNI-311): the durable queue segments travel through between
# ingestion (which gates a frame and publishes it) and query's consumer (which
# stores it and only then acknowledges it). The broker is created with these
# credentials, and both services connect with them. Generate a real password;
# the AMQP port is published on localhost only.
RABBITMQ_USER=omnisight
RABBITMQ_PASSWORD=changeme

# How many unacknowledged segments one consumer may hold at once. Without a
# limit the broker hands a single consumer the whole backlog, and a second
# consumer sits idle while the first works through it. Must be at least 1.
SEGMENT_PREFETCH=10
